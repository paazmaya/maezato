{
  "name": "maezato",
  "version": "0.16.0",
  "description": "Clone all repositories of a given user or organization at GitHub",
  "homepage": "https://github.com/paazmaya/maezato",
  "bugs": {
    "url": "https://github.com/paazmaya/maezato/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Juga Paazmaya",
    "email": "paazmaya@yahoo.com",
    "url": "https://paazmaya.fi"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/paazmaya/maezato.git"
  },
  "bin": {
    "maezato": "dist/bin/maezato.js"
  },
  "files": [
    "dist",
    "bin",
    "lib",
    "npm-shrinkwrap.json",
    "package.json",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./lib/clone-repo": {
      "import": "./dist/lib/clone-repo.js",
      "types": "./dist/lib/clone-repo.d.ts"
    },
    "./lib/add-remote": {
      "import": "./dist/lib/add-remote.js",
      "types": "./dist/lib/add-remote.d.ts"
    },
    "./lib/get-repos": {
      "import": "./dist/lib/get-repos.js",
      "types": "./dist/lib/get-repos.d.ts"
    },
    "./lib/literals": {
      "import": "./dist/lib/literals.js",
      "types": "./dist/lib/literals.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@octokit/graphql": "9.0.5",
    "got": "15.1.0",
    "mkdirp": "3.0.1",
    "optionator": "0.9.4",
    "progress": "2.0.3",
    "promise-each": "2.2.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/progress": "2.0.7",
    "c8": "11.0.0",
    "msw": "2.15.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.83.0",
    "tape": "5.10.2",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.12.0",
    "npm": ">=10.9.0"
  }
}
